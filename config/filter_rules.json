    "rss": [
      {"id": "alternative_credit_investor", "url": "https://alternativecreditinvestor.com/feed/", "region_hint": "US", "status": "verify_before_use"},
      {"id": "commercial_observer_finance", "url": "https://commercialobserver.com/finance/feed/", "region_hint": "US", "status": "verify_before_use"}
