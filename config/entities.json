  "exposure_policy": "Analyst-supplied monitoring scope, not asserted legal holdings. Specific mandates/sizes unconfirmed. Related entities and fund examples are not added holdings. Private exposure overlay stays outside Git.",
  "relationship_policy": "parent is an editorial edge typed by parent_relationship, not uniformly corporate ownership. relevant_subsidiaries includes platforms with explicitly typed edges. Empty official_domains authorizes no child-domain shortcut; parent evidence may support resolution.",
  "review_policy": "needs_review identifies a scoped limitation, not rejection of every verified match. Decisions dependent on the unresolved point must enter manual review.",
  "matching_rules": [
    {
      "rule_id": "ER01",
      "title": "Identity is not eligibility",
      "rule": "Resolve subject and role, then relevance. Match whole tokens/phrases in headline or body, never menus, footers, ads or related-story links. Save match span and article ID."
    },
    {
      "rule_id": "ER02",
      "title": "Official host is contextual evidence",
      "rule": "Parse/lowercase hostname; accept exact listed host or dot-delimited subdomain, never deceptive suffix (nb.com.evil.example). Host supports identity only with a relevant body subject. Verify new hosts and redirects."
    },
    {
      "rule_id": "ER03",
      "title": "Typed relationship propagation",
      "rule": "Resolve most specific entity first; save direct tag, parents and edge path separately. Parent attribution never proves economic ownership or shared losses. Check validity at event date. No sibling propagation."
    },
    {
      "rule_id": "ER04",
      "title": "Ticker qualification",
      "rule": "Require exchange plus symbol, or finance context explicitly linking symbol to issuer. Bare OWL/OTF insufficient. Distinguish OTF II and other Blue Owl vehicles."
    },
    {
      "rule_id": "ER05",
      "title": "Vehicle specificity",
      "rule": "Longest full name with explicit vintage/series takes precedence. Family-only reference resolves manager/strategy, vehicle unknown. Do not infer successors or mergers."
    },
    {
      "rule_id": "ER06",
      "title": "Namesake disambiguation",
      "rule": "Require qualified name or same-sentence investment-manager/credit context plus corroboration (official host/known parent). Conflicting namesake evidence enters review. Ignore a bare ambiguous token as an entity match; still evaluate article via B/C."
    },
    {
      "rule_id": "ER07",
      "title": "NB conditional match",
      "rule": "On nb.com NB needs fund/manager subject context in the body. Else require Neuberger co-mention or a verified full fund name. NB Private Debt/NB Strategic Capital family phrases resolve manager/strategy without invented vintage. NB alone ignored."
    },
    {
      "rule_id": "ER08",
      "title": "HSBC business boundary",
      "rule": "HSBC AM needs asset-management context. HSBC alone does not resolve AM. Group news requires explicit AM capital/governance/strategy transmission and review."
    }
  ],
